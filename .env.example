NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
NEXT_PUBLIC_SITE_URL=https://evolink.solairew.com.br

# Apenas no servidor (rota /api/invites/redeem). Nunca exponha no cliente.
SUPABASE_SERVICE_ROLE_KEY=

# Hook "Send Email" do Supabase Auth (rota /api/auth/send-email).
# Segredo gerado em Authentication → Hooks (formato v1,whsec_...).
SEND_EMAIL_HOOK_SECRET=
RESEND_API_KEY=
EMAIL_FROM=Evolink <admin@solairew.com.br>

# Banco Inter (API Pix). Certificado e chave ficam em /opt/evolink-secrets/inter
# no servidor, com os nomes certificado.crt e chave.key.
INTER_CLIENT_ID=
INTER_CLIENT_SECRET=
INTER_PIX_KEY=
INTER_ACCOUNT=
INTER_ENV=production

# Segredo que o pg_cron envia para /api/billing/reminders (mesmo valor do
# segredo 'billing_cron_secret' no Vault do Supabase).
CRON_SECRET=
